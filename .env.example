# ============================================================================
# ÜRETİM NOTU: Uygulama başlangıçta validateConfig() ile env'i denetler.
# NODE_ENV=production iken AŞAĞIDAKILER ZORUNLU, eksik/zayıfsa uygulama BAŞLAMAZ:
#   - SESSION_SECRET: en az 32 RASTGELE karakter, placeholder olamaz
#       Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   - APP_BASE_URL: https://... (localhost olamaz)
#   - SMS_MODE=live + sağlayıcı anahtarları (mock SMS ile canlıya çıkılmaz)
#   - EMAIL_MODE=live + SMTP anahtarları (halıcı hesap doğrulaması e-posta ile)
#   - AWS_S3_BUCKET + AWS anahtarları (container'da yerel disk kalıcı değil)
#   - PAYMENTS_MODE=live ise iyzico anahtarları + üretim BASE_URL (sandbox olamaz)
# ============================================================================

DATABASE_URL="postgresql://hali:hali@localhost:5433/hali?schema=public"
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Üretimde MUTLAKA değiştir (yukarıdaki komutla üret):
SESSION_SECRET=degistir-uzun-bir-deger
PLATFORM_COMMISSION_RATE=0.03

# --- Harita (boşsa ücretsiz OSM, doluysa Google Maps) ---
# DİKKAT: NEXT_PUBLIC_* değişkeni TARAYICI bundle'ına gömülür ve gizlenemez.
# Bu yüzden anahtarı Google Cloud Console'da MUTLAKA kısıtla:
#   - HTTP referrer: yalnız üretim domain'in (+ localhost:3000 dev için)
#   - API kısıtlaması: yalnız "Maps JavaScript API"
# Anahtar daha önce paylaşıldıysa ÖNCE rotasyona sok (yeni anahtar üret), sonra kısıtla.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Ödeme: mock | live ---
# live iken IYZICO_* zorunlu; üretimde IYZICO_BASE_URL sandbox OLAMAZ.
# mock iken yalnız NAKİT (CASH) kabul edilir; kartlı (CARD) ödeme reddedilir.
PAYMENTS_MODE=mock
IYZICO_API_KEY=
IYZICO_SECRET=
# Sandbox test için: https://sandbox-api.iyzipay.com  | Üretim: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# iyzico alıcı bloğunda identityNumber zorunlu. Hizmet satışında gerçek TC
# istenmiyor ve toplanmıyor; boş bırakılırsa iyzico'nun kendi dolgu sabiti
# kullanılır. Yalnızca üye işyeri farklı bir değer isterse doldurun.
IYZICO_BUYER_IDENTITY=

# --- E-posta (halıcı hesap doğrulama): mock | live ; herhangi bir SMTP sağlayıcısı ---
# live iken SMTP_* + EMAIL_FROM zorunlu. Kendi domainin, Gmail (uygulama şifresi),
# Brevo/SendGrid SMTP vb. çalışır. 465→SMTP_SECURE=true, 587→false (STARTTLS).
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="En Yakın Halı Yıkama <no-reply@enyakinhaliyikamaservisi.com>"

# --- SMS: mock | live ; sağlayıcı netgsm | twilio ---
SMS_MODE=mock
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Fotoğraf depolama: AWS_S3_BUCKET doluysa S3, boşsa yerel disk ---
# Üretimde (container/standalone) S3 ZORUNLU — yerel disk kalıcı değil.
AWS_S3_BUCKET=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL=

# --- Sezon hatırlatması ---
# 2026-07-30: env bayrağı YOK. Ayar veritabanında (AppState "sezon-ayarlar"),
# yönetimi /admin/hatirlatma ekranından — aç/kapa + aralık + elle tetikleme.
# Varsayılan KAPALI gelir; ticari ileti (6563/İYS) sorumluluğu açan admindedir.

# =========================================================
# TİCARİ KÜNYE (yasal sayfalar — ETAHS Yön. md.6/1 gereği zorunlu)
# =========================================================
# Boş bırakılırsa sayfalar "[...]" yer tutucusu gösterir, kunyeTamam() false döner.
NEXT_PUBLIC_SIRKET_TICARI_AD="En Yakın Halı Yıkama"
NEXT_PUBLIC_SIRKET_YASAL_AD=
NEXT_PUBLIC_SIRKET_ISLETME_TURU="şahıs işletmesi"
NEXT_PUBLIC_SIRKET_ADRES=
NEXT_PUBLIC_SIRKET_SEHIR=
NEXT_PUBLIC_SIRKET_VERGI_DAIRESI=
NEXT_PUBLIC_SIRKET_VERGI_NO=
NEXT_PUBLIC_SIRKET_KEP=
NEXT_PUBLIC_SIRKET_TELEFON=
NEXT_PUBLIC_SIRKET_EPOSTA=
