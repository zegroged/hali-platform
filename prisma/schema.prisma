// Halı Yıkama Platformu — veri modeli
// Kararlar: abonelik (2000 TL/ay) + kartla ödemede %3 komisyon, konum+puan sıralaması,
// halıcının kendi şoförleri, canlı konum + aylık durak kaydı, doğrulama rozetleri.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enum'lar

enum UserRole {
  CUSTOMER // müşteri
  CLEANER // halıcı / dükkan sahibi
  DRIVER // şoför
  ADMIN
  SUPPORT // müşteri hizmetleri — TEK yetkisi: doğrulamasız işletme açmak (/destek)
  ACCOUNTANT // mali müşavir — YALNIZ /muhasebe: fatura bilgileri + ödemeleri görür
  AGENT // komisyoncu — YALNIZ /komisyoncu: getirdiği işletmeler + komisyon kazançları
}

enum VerificationStatus {
  PENDING // başvurdu, admin onayı bekliyor
  VERIFIED // doğrulanmış işletme
  REJECTED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BadgeType {
  VERIFIED // Doğrulanmış İşletme
  INSURED // Sigortalı
  FAST_DELIVERY // Hızlı Teslim
  TOP_RATED // Çok Tercih Edilen
  FAST_RESPONDER // Hızlı Yanıt
}

enum OrderStatus {
  CREATED // müşteri oluşturdu, halıcıya düştü
  ACCEPTED // halıcı/şoför kabul etti
  REJECTED // reddedildi (sebep yazılır)
  PICKED_UP // şoför halıyı aldı
  WASHING // yıkanıyor
  OUT_FOR_DELIVERY // yola çıktı
  DELIVERED // teslim edildi
  CANCELED
}

enum PaymentMethod {
  CASH // kapıda nakit
  CARD // platform üzerinden (iyzico) — %3 komisyon
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PricingUnit {
  PER_M2 // metrekare başına
  PER_PIECE // parça/adet başına (el dokuma vs.)
  FLAT // sabit ücret
}

// ---------------------------------------------------------------- modeller

model User {
  id                String    @id @default(cuid())
  // OTURUM GEÇERLİLİK DAMGASI (2026-07-28 denetim — YÜKSEK).
  // Mobil Bearer token 30 gün geçerli ve İPTAL EDİLEMİYORDU: şifresi
  // sıfırlanan / işten çıkarılan şoför telefonundaki token'la aylarca
  // erişmeye devam edebilirdi. Şifre değişince buraya damga atılır; bu
  // tarihten ÖNCE üretilmiş tokenlar reddedilir (lib/auth.ts getBearerUser).
  sessionsValidFrom DateTime?
  role              UserRole
  name              String
  phone             String    @unique
  username          String?   @unique // girişte telefon YERİNE kullanılabilen ad (admin/destek hesapları)
  email             String?   @unique
  password          String? // hash; müşteri için opsiyonel
  phoneVerified     Boolean   @default(false)
  emailVerified     Boolean   @default(false) // halıcı hesap doğrulaması e-posta ile
  otpCode           String? // telefon SMS OTP (ayrı — e-posta ile çakışmasın)
  otpExpiresAt      DateTime?
  emailOtpCode      String? // e-posta doğrulama kodu (telefondan bağımsız)
  emailOtpExpiresAt DateTime?
  bannedAt          DateTime? // admin engeli: doluysa giriş + mevcut oturum kilitli
  points            Int       @default(0) // müşteri ödül puanı (yorum/sipariş ile kazanılır)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedBusiness CleanerBusiness? @relation("BusinessOwner")
  agentProfile  Agent?
  driverProfile Driver?
  orders        Order[]          @relation("CustomerOrders")
  reviews       Review[]
  notifications Notification[]
}

// Uygulama-içi bildirim (halıcı paneli + şoför + admin). SMS mock olduğundan
// içerideki kullanıcılara ulaşmanın asıl yolu budur: panel/şoför başlığındaki
// zil sayaç gösterir, açılınca liste + okundu işaretlenir.
model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // yeni-siparis | fiyat-onay | is-atandi | iptal | dogrulama | genel
  title     String
  body      String?
  href      String? // tıklanınca gidilecek panel içi yol
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model CleanerBusiness {
  waMessages        WhatsAppMessage[]
  cashHandovers     CashHandover[]
  id          String  @id @default(cuid())
  owner       User    @relation("BusinessOwner", fields: [ownerId], references: [id])
  ownerId     String  @unique
  name        String
  description String?
  address     String
  city        String
  district    String
  lat         Float
  lng         Float
  phone       String
  // Ek iletişim numaraları — müşteri vitrini "Sabit Hat" + "GSM & WhatsApp"
  // gruplu gösterir. phone birincil GSM'dir (SMS bildirimleri oraya gider).
  gsmPhone2     String? // ikinci GSM & WhatsApp numarası
  landlinePhone String? // sabit hat (0 2xx/3xx/4xx...)
  // WHATSAPP DOĞRULAMASI (2026-07-26): işletme kaydının kapısı e-postadır
  // (sabit hatta OTP gitmez); WhatsApp numarası AYRI doğrulanır. Doğrulanan
  // numara burada saklanır — sonradan değişirse doğrulama düşer.
  whatsappNumber     String?
  whatsappVerifiedAt DateTime?

  workingHours            Json? // {"mon":{"open":"09:00","close":"19:00"}, ...}
  deliveryEstimateMinDays Int? // örn 2
  deliveryEstimateMaxDays Int? // örn 3

  taxNumber          String? // vergi no (doğrulama için) — VKN(10)/TCKN(11)
  // FATURA BİLGİLERİ: platform işletmeye abonelik faturası keserken (mali müşavir
  // /muhasebe'de görür) mevzuaten gerekli alanlar. Abonelik ödemesinden ÖNCE zorunlu.
  billingTitle       String? // fatura ünvanı (yasal unvan; name yalnız görünen ad)
  taxOffice          String? // vergi dairesi
  billingAddress     String? // fatura adresi (abonelik ödemesi öncesi zorunlu)
  billingCode        String? @unique // cari/abone kodu (HY-0001) — muhasebe eşleştirmesi
  // İşletme logosu (kare, ≤512px WebP) — kartta ve profil başlığında gösterilir.
  logoUrl            String?
  googleProfileUrl   String? // işletmenin Google Haritalar/İşletme profili linki (gerçek Google yorumları)
  contractAcceptedAt DateTime? // platform sözleşmesi onay zamanı
  contractVersion    String? // onaylanan aracılık sözleşmesi sürümü (ETAHS Yön. md.11/2-c)
  verification       VerificationStatus @default(PENDING)
  isVisible          Boolean            @default(false) // profil tam + doğrulanmış olunca true
  // Admin/destek eliyle açıldı: şoför YAYIN şartından muaf (sipariş almak
  // için yine şoför gerekir — sipariş API'si engeller).
  createdByAdmin     Boolean            @default(false)
  // DEMO İŞLETME (2026-07-30): komisyoncunun dükkânda ürünü GÖSTEREBİLMESİ
  // için açılan, gerçekçi sahte veriyle dolu hesap. GERÇEK SAYILARA SIZMAZ:
  // keşif, sitemap, il/ilçe sayfaları, ana sayfa il butonları, "şehrinde
  // halıcı açıldı" müjde maili, admin sayaçları ve KOMİSYON tahakkuku
  // dışında tutulur. (env tabanlı SEO_NOINDEX_BUSINESS_IDS ölçeklenmiyordu.)
  isDemo             Boolean            @default(false)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  adminNote String? // yalnız admin görür: denetim/gerekçe notları

  // Tatil modu: bu tarihe kadar YENİ kamu siparişi kabul edilmez (profil yayında
  // kalır, sipariş butonu kapanır; panelden manuel sipariş etkilenmez).
  pausedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceAreas ServiceArea[]
  ledgerEntries      LedgerEntry[]
  ledgerRecurrences  LedgerRecurrence[]
  photos       BusinessPhoto[]
  pricing      PricingItem[]
  drivers      Driver[]
  orders       Order[]
  reviews      Review[]
  badges       Badge[]
  subscription Subscription?
  payments     SubscriptionPayment[]
  commissions  CommissionEntry[]
  // Komisyoncu referansı: bu işletmeyi platforma hangi komisyoncu getirdi.
  // Her abonelik ödemesinde (yenileme dahil) komisyon tahakkuku üretir.
  referredByAgent   Agent?  @relation(fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredByAgentId String?
  usedReferralCodes AgentReferralCode[] @relation("CodeUsedBy")
  // Abonelik indirimi: discountUntil geçerliyken her ödeme %discountPercent
  // indirimli tahsil edilir (kaynak: premium komisyoncu kodu VEYA admin eli).
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountUntil   DateTime?
  // İNDİRİMİ KİM VERDİ (2026-07-26): komisyoncu kodundan geldiyse o komisyoncunun
  // id'si; admin elle verdiyse null. Kural: indirimin YARISI, indirimi veren
  // komisyoncunun komisyonundan düşer (kalan yarısı platformdan). Admin verdiyse
  // tamamı platformdan. Bkz. lib/commission.ts.
  discountGrantedByAgentId String?

  @@index([city, district])
}

// ---- KASA: GELİR-GİDER DEFTERİ (2026-07-26) ----
// Halıcının kendi işletme muhasebesi (platform muhasebesi DEĞİL): giderleri elle
// girer (personel maaşı, deterjan, kira, fatura...), GELİR teslim edilen
// siparişlerden OTOMATİK sayılır; toplamlar/kâr-zarar sistem hesaplar.
// Tekrarlayan kalemler (her 3 günde deterjan, aylık maaş) periyotla tanımlanır;
// vadesi gelince kayıt kendiliğinden oluşur (lib/ledger.ts, saatlik tik).
enum LedgerKind {
  EXPENSE // gider
  INCOME // elle eklenen ek gelir (siparişler dışında)
}

enum LedgerCategory {
  PERSONEL // maaş, sigorta, yemek
  MALZEME // deterjan, kimyasal, yedek parça
  KIRA
  FATURA // elektrik, su, doğalgaz, internet
  YAKIT // araç yakıtı
  ARAC // bakım, sigorta, lastik
  VERGI // vergi, SGK, muhasebe
  DIGER
}

model LedgerEntry {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  kind       LedgerKind      @default(EXPENSE)
  category   LedgerCategory  @default(DIGER)
  // SERBEST KATEGORİ (2026-07-27): sabit 8 kalıp her işletmeye uymuyordu
  // ("adamları neden bir kategoriye sığdırmaya çalışıyoruz"). Halıcı kendi
  // adını yazar; enum kaba kova olarak kalır (eski kayıtlarla uyum + gruplama
  // yedeği). Dolu olduğunda ekranda ve özet tablosunda BU gösterilir.
  categoryLabel String?
  label      String // "Ahmet maaş", "Omo 5kg x4"
  amount     Decimal         @db.Decimal(10, 2)
  date       DateTime // kalemin ait olduğu gün (elle seçilebilir)
  note       String?
  // Tekrarlayan kalemin kopyası mı (hangi kuraldan üretildi):
  recurrence   LedgerRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  recurrenceId String?
  createdAt  DateTime        @default(now())

  @@index([businessId, date])
}

// Tekrarlayan gider/gelir kuralı: "her N günde" ya da "her ayın X'i".
model LedgerRecurrence {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  kind       LedgerKind      @default(EXPENSE)
  category   LedgerCategory  @default(DIGER)
  label      String
  amount     Decimal         @db.Decimal(10, 2)
  everyDays  Int? // her N günde bir (ör. 3 = deterjan)
  monthDay   Int? // her ayın bu günü (1-28; ör. maaş)
  active     Boolean         @default(true)
  nextRunAt  DateTime // bir sonraki üretim zamanı (bekçi bunu okur)
  createdAt  DateTime        @default(now())

  entries LedgerEntry[]

  @@index([businessId, active])
  @@index([active, nextRunAt])
}

model ServiceArea {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  city       String
  district   String

  @@index([city, district])
}

model BusinessPhoto {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  url        String
  isBefore   Boolean         @default(false)
  isAfter    Boolean         @default(false)
  caption    String?
  createdAt  DateTime        @default(now())
}

model PricingItem {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  label      String // "Makine Halısı", "Yün/El Dokuma", "Saçak Onarımı" vb.
  unit       PricingUnit     @default(PER_M2)
  price      Decimal         @db.Decimal(10, 2)
  isAddon    Boolean         @default(false) // ek hizmet mi
  createdAt  DateTime        @default(now())
}

model Driver {
  cashHandovers CashHandover[]
  id         String          @id @default(cuid())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String          @unique
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  isOnShift  Boolean   @default(false) // mesaide mi
  lastLat    Float? // en güncel canlı konum
  lastLng    Float?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  orders          Order[]
  pings           DriverLocationPing[]
  stops           DriverStop[]
  privacyNoticeAt DateTime? // KVKK aydınlatmasının şoföre ilk gösterim anı (Tebliğ md.6)
}

// ham konum akışı — halıcının canlı izlemesi için
model DriverLocationPing {
  id         String   @id @default(cuid())
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId   String
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  @@index([driverId, recordedAt])
}

// durak kaydı — "şu saatte, şu konumda, şu kadar durdu"; aylık raporlanır
model DriverStop {
  id          String    @id @default(cuid())
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId    String
  lat         Float
  lng         Float
  address     String? // ters-geocode (opsiyonel)
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int? // ne kadar durdu
  periodYear  Int // aylık raporlama için
  periodMonth Int
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?

  @@index([driverId, periodYear, periodMonth])
}

model Order {
  waMessages    WhatsAppMessage[]
  id            String  @id @default(cuid())
  trackingToken String  @unique @default(cuid()) // SMS takip linki
  code          String? @unique // kısa, müşteri-dostu takip kodu (ör. HLK-4F2A9)

  customer      User?   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  customerName  String // kayıtsız müşteri de sipariş verebilir
  customerPhone String
  // Opsiyonel: takip linki e-postayla gider (SMS ertelendi — bedava teyit kanalı).
  customerEmail String?
  pickupAddress String
  pickupLat     Float?
  pickupLng     Float?
  approxM2      Float?
  note          String?

  business   CleanerBusiness @relation(fields: [businessId], references: [id])
  businessId String
  driver     Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId   String?

  status           OrderStatus @default(CREATED)
  rejectReason     String?
  // Panelden (dükkâna gelen müşteri için) açılan manuel kayıt — SLA bekçisi,
  // 24s kurtarma ve "yanıt vermedi" bandı bu siparişleri ATLAR.
  isManual         Boolean     @default(false)
  // SLA bekçisi: CREATED'da bekleyen sipariş için işletmeye hatırlatma atıldıysa
  // (sipariş başına bir kez; saatlik tik src/lib/orderSla.ts)
  staleRemindedAt  DateTime?
  // 24 saat kademesi: üye müşteriye e-posta + adminlere zil atıldıysa (bir kez)
  staleEscalatedAt DateTime?

  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  priceTotal    Decimal?      @db.Decimal(10, 2)
  commission    Decimal?      @db.Decimal(10, 2) // kartla ödemede %3

  // TAHSİLAT — TESLİMDEN AYRI BİR OLAY (2026-07-29).
  //
  // ÖNCESİ: nakit teslimde `paymentStatus` ÜÇ ayrı yerde koşulsuz "PAID"
  // yazılıyordu (panel/actions.ts, sofor/actions.ts, lib/driverOrders.ts).
  // Yani "teslim ettim ama parayı almadım" durumu TEMSİL EDİLEMİYORDU ve
  // sistem her nakit teslimde "tahsil edildi" diye YALAN söylüyordu.
  //
  // Bu tek eksik üç özelliği birden kilitliyordu: gün sonu tahsilat
  // mutabakatı, kurumsal cari (ay sonu fatura), ve ödeme linki.
  //
  // ARTIK: tahsilat teslim eden kişinin BEYANIDIR. İşaretlenmezse sipariş
  // "teslim edildi, tahsil edilmedi" durumunda kalır.
  collectedAmount Decimal?  @db.Decimal(10, 2) // fiilen tahsil edilen tutar
  collectedAt     DateTime? // tahsilat anı
  collectedById   String? // tahsil eden kullanıcı (şoför veya halıcı)
  // TAHSİLAT YÖNTEMİ: "CASH" | "IBAN" (2026-07-30 kullanıcı isteği).
  // NEDEN AYRIM ÖNEMLİ: IBAN'a gelen para ZATEN işletmenin hesabında —
  // şoförün üzerinde nakit BIRAKMAZ. Mutabakatta "şoförde bekleyen" hesabı
  // yalnız NAKİT tahsilattan yürür; ikisi karışırsa halıcı şoförden olmayan
  // parayı ister. Enum yerine String: yarın "kredi kartı" eklenirse
  // migration gerekmesin (katmerli kalsın).
  collectedMethod String?
  // SEZON HATIRLATMASI (2026-07-30): bu siparişin müşterisine hatırlatma
  // gönderildiği an. Aynı kişiye tekrar tekrar gönderilmesini engeller.
  // ⚠️ Gönderim BAYRAK ARKASINDA (SEZON_HATIRLATMA=1) — hukuki taraf
  // (6563 + İYS + işletme sözleşmesi §) işletme sahibinde.
  seasonRemindedAt DateTime?

  @@index([businessId, collectedAt])

  pickupPhotoUrl   String?
  deliveryPhotoUrl String? // şoförün teslimde çektiği kanıt fotoğrafı

  // Mesafeli Sözleşmeler Yönetmeliği md.7: ön bilgilendirme TEYİDİ — onay kutusu
  // işaretlendiği an + o an geçerli sözleşme sürümü (ispat yükü platformda).
  consentAt       DateTime?
  contractVersion String?

  // md.15/1-h: kesin fiyat bildirimi + müşterinin ifaya başlama ONAYI (ispatlı).
  quotedPrice     Decimal?  @db.Decimal(10, 2) // işletmenin ölçüm sonrası bildirdiği kesin fiyat
  priceApprovedAt DateTime? // müşterinin takip sayfasından onay anı
  // TESLİM ANI (2026-07-26): Kasa'daki aylık gelir bu tarihe göre sayılır.
  // updatedAt kullanılırsa sipariş sonradan güncellendiğinde gelir başka aya
  // kayardı (muhasebe hatası). Eski kayıtlarda null → updatedAt'e düşülür.
  deliveredAt     DateTime?
  estimatedDays   Int? // halıcının verdiği tahmini teslim süresi (gün)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OrderEvent[]
  photos OrderPhoto[]
  review Review?
  stops  DriverStop[]

  @@index([businessId, status])
}

// Kayıt öncesi e-posta doğrulama kodu (hesap henüz yokken; 10 dk geçerli).
// TELEFON DOĞRULAMA KODU (2026-07-26): kullanıcı HENÜZ YOKKEN (müşteri kaydı)
// numaraya gönderilen kod. WhatsApp üzerinden gider (SMS pahalı). E-posta
// tarafındaki SignupOtp ile aynı mantık.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  attempts  Int      @default(0) // 5 yanlışta kilit
  createdAt DateTime @default(now())
}

model SignupOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  attempts  Int      @default(0) // yanlış deneme sayısı (5'te kilit)
  createdAt DateTime @default(now())
}

// SMS gönderim kaydı — bilgilendirme/teyitlerin ispatı (Mesafeli Yön. md.20).
model SmsLog {
  id        String   @id @default(cuid())
  to        String
  body      String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

// Halıcının siparişe eklediği fotoğraflar (önce/sonra, süreç) — müşteri takipte görür.
model OrderPhoto {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  url       String
  // ÇEKİLDİĞİ AŞAMA (2026-07-30) — QR/barkod yerine FOTOĞRAFLA EŞLEŞTİRME
  // kararının çekirdeği. "ALIM" | "YIKAMA" | "TESLIM". Müşteri takip
  // sayfasında halısını aşama aşama görür; tesiste "bu kimin halısı"
  // sorusu fotoğrafla cevaplanır. Eski kayıtlar null kalır.
  stage     String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Review {
  id         String          @id @default(cuid())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String          @unique // yorum sadece tamamlanmış siparişten (sipariş başına 1)
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  // Misafir müşteri (hesapsız, takip koduyla) yorum bırakabilir → opsiyonel.
  // Görünen ad siparişteki customerName'den gelir (maskelenerek).
  customer   User?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String?
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([businessId])
}

model Subscription {
  id                 String             @id @default(cuid())
  business           CleanerBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId         String             @unique
  status             SubscriptionStatus @default(TRIAL)
  priceMonthly       Decimal            @default(2000) @db.Decimal(10, 2)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // iyzico tekrarlayan abonelik (düzenli ödeme talimatı) — her ay otomatik çekim.
  iyzicoSubRef      String?   @unique // iyzico subscriptionReferenceCode
  iyzicoCustomerRef String? // iyzico customerReferenceCode (kart saklı)
  autoRenew         Boolean   @default(false) // aktif düzenli ödeme talimatı var mı
  canceledAt        DateTime? // talimat iptal anı (dönem sonuna kadar açık kalır)

  // ELLE ÖDEYENLER İÇİN YENİLEME BEKÇİSİ (2026-07-25): banka kartlı işletmeler
  // talimat veremiyor (iyzico abonelik NON3D → debit reddi), her ay elle ödüyor.
  // Sessizce yayından düşmesinler diye 3 gün önce hatırlatma, dolduğunda bildirim
  // gider. Alanlar HANGİ dönem için gönderildiğini tutar → dönem başına tek mail.
  renewalRemindedFor DateTime?
  expiredNotifiedFor DateTime?
}

// Abonelik ödemesi kaydı — iyzico Checkout. Idempotency (çift callback/replay)
// ve yasal saklama (6563 md.11/3 on yıl) için her ödeme burada tutulur.
model SubscriptionPayment {
  id              String          @id @default(cuid())
  business        CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String
  // iyzico'ya conversationId olarak bu kaydın id'si gider; callback bununla bulur.
  status          String          @default("PENDING") // PENDING | PAID | FAILED
  amount          Decimal         @db.Decimal(10, 2) // KDV dahil tahsil edilen (2400)
  iyzicoToken     String? // checkout token
  iyzicoPaymentId String?         @unique // iyzico ödeme kimliği — idempotency anahtarı
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime        @default(now())
  paidAt          DateTime?

  @@index([businessId])
  commission CommissionEntry?
}

// ---- KOMİSYONCU (satış ortağı) sistemi ----
// Admin hesap açarken yüzdeyi belirler; komisyoncunun koduyla gelen her
// işletmenin HER abonelik ödemesinde (ilk + yenileme) KDV HARİÇ net tutar
// üzerinden komisyon tahakkuk eder — abonelik sürdükçe devam eder.
model Agent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  percent   Decimal  @db.Decimal(5, 2) // NET (KDV hariç) tutar üzerinden yüzde
  active    Boolean  @default(true) // pasif komisyoncuya YENİ tahakkuk işlemez
  // PREMIUM yetkisi (2026-07-23): kod üretirken abonelik fiyatına istediği
  // yüzdede + istediği sürede indirim tanımlayabilir. Admin verir/alır.
  // BAŞ komisyoncu bu yetkiyi ALTINA GEÇİREMEZ (2026-07-25 kullanıcı kararı).
  canDiscount Boolean @default(false)
  // İNDİRİM TAVANI (2026-07-26): bu komisyoncunun koda gömebileceği EN YÜKSEK
  // indirim yüzdesi. Baş komisyoncunun açtığı hesaplarda ZORUNLU ve platform
  // sınırı %20'dir (lib/discount.ts MAX_SUB_DISCOUNT). null = sınırsız
  // (yalnız admin'in doğrudan verdiği yetkilerde).
  maxDiscountPercent Decimal? @db.Decimal(5, 2)
  maxDiscountMonths  Int? // indirimin en fazla kaç ay süreceği (null = sınırsız)

  // ---- BAŞ KOMİSYONCU (2 kademe; 2026-07-25) ----
  // isHead: kendi panelinden komisyoncu hesabı açabilir, yüzdelerini belirler.
  // poolPercent: bu ağacın HAVUZ payı (admin belirler, varsayılan 50). Baş
  // komisyoncu alta en çok bu kadar verebilir; FARKI kendisi alır. Kendi
  // kodundan getirdiği işletmede havuzun tamamını alır (percent = poolPercent).
  // parentId: alt komisyoncunun baş komisyoncusu (3. kademe YOK — alt hesap açamaz).
  isHead      Boolean  @default(false)
  poolPercent Decimal? @db.Decimal(5, 2)
  // ADMIN DONDURDU: baş komisyoncu bunu kendi panelinden geri AÇAMAZ (inceleme
  // bulgusu — aynı `active` bayrağı kullanılınca admin kararı sessizce geri
  // alınabiliyordu). Yalnız admin kaldırır.
  suspendedByAdmin Boolean @default(false)
  parent      Agent?   @relation("AgentTree", fields: [parentId], references: [id], onDelete: SetNull)
  parentId    String?
  children    Agent[]  @relation("AgentTree")

  // ÖDEME (çekim) bilgileri — 2026-07-26: komisyoncu birikmiş bakiyesi için
  // çekim talebi oluşturur; istersen her ayın belirli günü OTOMATİK talep düşer.
  // Havale/EFT'yi admin elle yapar (iyzico dışarıya para göndermez).
  iban      String? // TR.. (yalnız admin ve sahibi görür)
  // 2026-07-31 (kullanıcı isteği): havale için hesap sahibinin AD SOYADI şart —
  // bankalar isim uyuşmazlığında havaleyi geri çevirebiliyor.
  ibanName  String?
  // Gider pusulası için TCKN/VKN (opsiyonel; stopajlı ödemede belgeye yazılır).
  taxId     String?
  // Gider pusulası zorunlu alanı (VUK 234): işi yapanın ADRESİ. IBAN ile
  // birlikte istenir — pusula/dekont dökümü adressiz şeklen eksik kalır.
  address   String?
  // FATURA MÜKELLEFİ (2026-07-31): true = komisyoncu vergi mükellefi, ödemeye
  // FATURA keser → stopaj UYGULANMAZ (brüt ödenir). false = mükellef değil →
  // aylık eşik aşıldığında ödeme anında stopaj OTOMATİK hesaplanıp kaydedilir.
  faturaMukellefi Boolean @default(false)
  payoutDay Int? // 1-28: her ay bu gün otomatik çekim talebi oluşur

  createdAt DateTime @default(now())

  // BÖLGE (2026-07-28): komisyoncunun sorumlu olduğu il/ilçeler. Bir kişi
  // birden fazla ilçe alabilir (Şehitkamil + Şahinbey gibi). Çakışma ENGEL
  // DEĞİL — kullanıcı kararı: "10 komisyoncu atansa bir işletme bile kayıt
  // olmasa izin verilmemesi kötü olur". Atarken UYARILIR, karar insanın.
  territories AgentTerritory[]

  referrals   CleanerBusiness[]
  entries     CommissionEntry[]
  headEntries CommissionEntry[]   @relation("HeadCommissions")
  codes       AgentReferralCode[]
  payouts     PayoutRequest[]

  @@index([parentId])
}

// KOMİSYONCU BÖLGESİ (2026-07-28): "hangi komisyoncu nereden sorumlu".
// Amaç çakışmayı ENGELLEMEK değil GÖRÜNÜR KILMAK — kim nerede çalışıyor,
// hangi ilçe boşta, hangi ilçede kaç işletme kayıtlı.
// İl+ilçe `lib/cities.ts` + `lib/districts.ts` listesinden gelir (serbest metin
// değil); böylece işletme kayıtlarıyla aynı adlarla eşleşir ve sayım tutar.
model AgentTerritory {
  id        String   @id @default(cuid())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  city      String // kanonik il adı ("Gaziantep")
  district  String // kanonik ilçe adı ("Şehitkamil")
  createdAt DateTime @default(now())

  // Aynı komisyoncuya aynı ilçe iki kez yazılmasın.
  @@unique([agentId, city, district])
  @@index([city, district])
}

// KOMİSYON ÇEKİM TALEBİ: komisyoncunun "birikeni öde" isteği. Admin panelinde
// listelenir, havale yapılınca "Ödendi" işaretlenir → o ana kadarki TÜM
// ödenmemiş tahakkuklar (kendi payı + baş komisyoncuysa havuz farkı) ödenmiş
// sayılır. Statü: PENDING | PAID | REJECTED.
model PayoutRequest {
  id         String    @id @default(cuid())
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentId    String
  amount     Decimal   @db.Decimal(10, 2) // talep anındaki bakiye (bilgi amaçlı)
  paidAmount Decimal?  @db.Decimal(10, 2) // ödeme anında fiilen kapatılan tutar
  iban       String? // talep anındaki IBAN kopyası (sonradan değişse de kayıt sabit)
  ibanName   String? // talep anındaki hesap sahibi adı (havale isim uyuşması için)
  // STOPAJ KAYDI (2026-07-31, kullanıcı kararı: "kesinti otomatik olmalı"):
  // ödeme PAID işaretlenirken sistem hesaplar ve BURAYA yazar — sonradan oran
  // değişse de tarihi kayıt sabittir. Mükellef/eşik-altı ödemede üçü de null.
  stopajOran  Decimal? @db.Decimal(5, 2)
  stopajTutar Decimal? @db.Decimal(10, 2)
  netTutar    Decimal? @db.Decimal(10, 2)
  // Ödeme ANINDAKİ mükelleflik kopyası (denetim: canlı bayrak okununca admin
  // sonradan değiştirdiğinde geçmiş dökümün "Fatura/—" etiketi değişiyordu).
  mukellefti  Boolean?
  status     String    @default("PENDING")
  auto       Boolean   @default(false) // aylık otomatik mi, elle mi
  note       String? // komisyoncunun notu
  adminNote  String? // ret sebebi / havale referansı
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([agentId, createdAt])
  @@index([status, createdAt])
}

// TEK KULLANIMLIK referans kodu (2026-07-23 kullanıcı kararı: kalıcı kod YOK):
// komisyoncu her müşteri için panelinden yeni kod üretir; kod bir işletmeye
// bağlanınca YANAR (usedAt dolar), tekrar kullanılamaz.
model AgentReferralCode {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  code      String    @unique // HYK-XXXXXX
  // Koda gömülü abonelik indirimi (yalnız canDiscount komisyoncu tanımlar):
  // kodla kaydolan işletmenin fiyatı discountMonths boyunca %discountPercent düşer.
  discountPercent Decimal? @db.Decimal(5, 2)
  discountMonths  Int?
  createdAt DateTime  @default(now())
  usedAt    DateTime? // dolunca kod tükenmiştir
  usedByBusiness   CleanerBusiness? @relation("CodeUsedBy", fields: [usedByBusinessId], references: [id], onDelete: SetNull)
  usedByBusinessId String?

  @@index([agentId, createdAt])
}

model CommissionEntry {
  id         String              @id @default(cuid())
  // Restrict (inceleme bulgusu): komisyon DEFTERİ silinme zincirleriyle yok
  // olmasın — ödenmemiş borç kaydı, bağlı kayıt silinse bile korunur.
  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentId    String
  business   CleanerBusiness     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId String
  payment    SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId  String              @unique // idempotency: her ödemeye EN FAZLA 1 komisyon
  grossAmount Decimal @db.Decimal(10, 2) // tahsil edilen (KDV dahil)
  netAmount   Decimal @db.Decimal(10, 2) // KDV hariç matrah
  percent     Decimal @db.Decimal(5, 2) // tahakkuk anındaki yüzde (sonradan değişse de sabit)
  amount      Decimal @db.Decimal(10, 2) // komisyoncuya ödenecek tutar
  paidAt      DateTime? // admin "ödendi" işaretleyince dolar
  createdAt   DateTime  @default(now())

  // ---- BAŞ KOMİSYONCU PAYI (2026-07-25) ----
  // Aynı ödemede iki hak sahibi olabilir: alt komisyoncu (yukarıdaki alanlar) ve
  // onun baş komisyoncusu (havuz farkı). AYRI SATIR AÇMIYORUZ — paymentId @unique
  // idempotency kilidi bozulmasın diye baş payı aynı satırda tutulur; ödeme
  // durumları (paidAt / headPaidAt) bağımsız işaretlenir.
  headAgent   Agent?    @relation("HeadCommissions", fields: [headAgentId], references: [id], onDelete: Restrict)
  headAgentId String?
  headPercent Decimal?  @db.Decimal(5, 2)
  headAmount  Decimal?  @db.Decimal(10, 2)
  headPaidAt  DateTime?

  // ATLANDI İŞARETİ (inceleme bulgusu): komisyoncu PASİFken yapılan ödemeye
  // hiç satır yazılmayınca ödeme "commission: null" kalıyor ve saatlik backfill
  // komisyoncu sonradan aktive edilince 90 GÜNE KADAR GERİYE DÖNÜK para basıyordu.
  // Artık pasif dönemde 0 tutarlı bu satır yazılır: paymentId kilidi dolar,
  // backfill bir daha uğramaz, "pasif dönem = tahakkuk yok" kalıcı olur.
  // Toplamlarda ve listelerde HARİÇ tutulur.
  skipped     Boolean   @default(false)

  @@index([agentId, createdAt])
  @@index([headAgentId, createdAt])
}

model Badge {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  type       BadgeType
  grantedAt  DateTime        @default(now())

  @@unique([businessId, type])
}

// Boş şehir/ilçe sayfasındaki "açılınca haber ver" e-posta kaydı. İki amaç:
// (1) şehir açılınca hazır müşteri listesi, (2) hangi şehirde talep biriktiği
// verisi (işletme kazanım görüşmelerinde kullanılır; /admin'de sayılır).
model CityLead {
  id         String    @id @default(cuid())
  city       String // kanonik il adı (src/lib/cities.ts)
  district   String? // ilçe sayfasından geldiyse kanonik ilçe adı
  email      String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // "bölgende açıldık" maili atıldıysa (kişi başı bir kez)

  @@unique([city, email]) // aynı il için aynı e-posta bir kez (upsert)
  @@index([city])
}

// Genel amaçlı anahtar-değer durumu (tekil zamanlayıcı işaretleri vb. —
// örn. weeklyDigestSentAt: haftalık özet maili en son ne zaman gitti).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ŞOFÖRDEN HALICIYA NAKİT TESLİMİ (2026-07-29).
//
// NEDEN AYRI MODEL: "şoför üzerinde bekleyen nakit" bir BAYRAK değil, bir
// BAKİYEDİR. Şoför tahsil eder → bakiyesi artar; halıcıya parayı verir →
// bakiye kapanır. Siparişe konan tek bir "teslim ettim" işareti bunu
// gösteremez, çünkü para siparişten bağımsız olarak toplu devrediliyor
// ("bugünkü 8.400 lirayı akşam verdim").
//
// Bakiye = (tahsil edilen siparişlerin toplamı) − (devredilen tutar).
model CashHandover {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  // Parayı getiren şoför. Şoför kaydı silinse bile GEÇMİŞ SİLİNMEZ
  // (muhasebe kaydı) — Kasa'daki kararın aynısı.
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?
  // Kayıt anındaki şoför adı: şoför silinirse geçmiş okunabilir kalsın.
  driverName String
  amount     Decimal  @db.Decimal(10, 2)
  note       String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([driverId, createdAt])
}

// WHATSAPP MESAJ KUTUSU (2026-07-29).
//
// NEDEN: Cloud API'de müşterinin yazdığı mesaj YALNIZ webhook'a düşer; okunacak
// bir "gelen kutusu" yoktur. 29 Temmuz'da webhook yazıldı ve müşteri mesajlarının
// sunucuya ulaştığı doğrulandı ("Sa" mesajı log'a düştü) — ama görüntülenecek yer
// olmadığı için hiç kimse görmüyordu. Müşteri "halım nerede" yazsa kayboluyordu.
//
// İŞLETME İZOLASYONU: businessId ZORUNLU DEĞİL, çünkü tanımadığımız bir numara
// yazabilir (hiç siparişi olmayan biri). Eşleşmeyenler businessId=null kalır ve
// YALNIZ admin görür. Panel sorguları HER ZAMAN businessId ile daraltılmalı —
// halıcının başka halıcının mesajını görmesi en ağır sızıntı olur.
model WhatsAppMessage {
  id        String   @id @default(cuid())
  // Meta'nın mesaj kimliği (wamid). Webhook aynı olayı tekrar gönderebilir;
  // benzersiz olması ÇİFT KAYDI engeller (Meta 200 almazsa tekrar dener).
  waId      String   @unique
  // IN = müşteriden geldi, OUT = biz gönderdik
  direction String
  phone     String // karşı taraf (E.164'süz, 905xxxxxxxxx)
  name      String? // WhatsApp profil adı (yalnız gelen mesajlarda gelir)
  body      String
  // Eşleşme: gelen numara son siparişin müşteri numarasıyla tutuyorsa oraya bağlanır.
  business   CleanerBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String?
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  // Gönderim başarısızsa Meta'nın sebebi (yalnız OUT).
  error     String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([phone, createdAt])
}
