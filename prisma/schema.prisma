// Halı Yıkama Platformu — veri modeli
// Kararlar: abonelik (2000 TL/ay) + kartla ödemede %3 komisyon, konum+puan sıralaması,
// halıcının kendi şoförleri, canlı konum + aylık durak kaydı, doğrulama rozetleri.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enum'lar

enum UserRole {
  CUSTOMER // müşteri
  CLEANER // halıcı / dükkan sahibi
  DRIVER // şoför
  ADMIN
  SUPPORT // müşteri hizmetleri — TEK yetkisi: doğrulamasız işletme açmak (/destek)
  ACCOUNTANT // mali müşavir — YALNIZ /muhasebe: fatura bilgileri + ödemeleri görür
  AGENT // komisyoncu — YALNIZ /komisyoncu: getirdiği işletmeler + komisyon kazançları
}

enum VerificationStatus {
  PENDING // başvurdu, admin onayı bekliyor
  VERIFIED // doğrulanmış işletme
  REJECTED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BadgeType {
  VERIFIED // Doğrulanmış İşletme
  INSURED // Sigortalı
  FAST_DELIVERY // Hızlı Teslim
  TOP_RATED // Çok Tercih Edilen
  FAST_RESPONDER // Hızlı Yanıt
}

enum OrderStatus {
  CREATED // müşteri oluşturdu, halıcıya düştü
  ACCEPTED // halıcı/şoför kabul etti
  REJECTED // reddedildi (sebep yazılır)
  PICKED_UP // şoför halıyı aldı
  WASHING // yıkanıyor
  OUT_FOR_DELIVERY // yola çıktı
  DELIVERED // teslim edildi
  CANCELED
}

enum PaymentMethod {
  CASH // kapıda nakit
  CARD // platform üzerinden (iyzico) — %3 komisyon
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PricingUnit {
  PER_M2 // metrekare başına
  PER_PIECE // parça/adet başına (el dokuma vs.)
  FLAT // sabit ücret
}

// ---------------------------------------------------------------- modeller

model User {
  id                String    @id @default(cuid())
  role              UserRole
  name              String
  phone             String    @unique
  username          String?   @unique // girişte telefon YERİNE kullanılabilen ad (admin/destek hesapları)
  email             String?   @unique
  password          String? // hash; müşteri için opsiyonel
  phoneVerified     Boolean   @default(false)
  emailVerified     Boolean   @default(false) // halıcı hesap doğrulaması e-posta ile
  otpCode           String? // telefon SMS OTP (ayrı — e-posta ile çakışmasın)
  otpExpiresAt      DateTime?
  emailOtpCode      String? // e-posta doğrulama kodu (telefondan bağımsız)
  emailOtpExpiresAt DateTime?
  bannedAt          DateTime? // admin engeli: doluysa giriş + mevcut oturum kilitli
  points            Int       @default(0) // müşteri ödül puanı (yorum/sipariş ile kazanılır)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedBusiness CleanerBusiness? @relation("BusinessOwner")
  agentProfile  Agent?
  driverProfile Driver?
  orders        Order[]          @relation("CustomerOrders")
  reviews       Review[]
  notifications Notification[]
}

// Uygulama-içi bildirim (halıcı paneli + şoför + admin). SMS mock olduğundan
// içerideki kullanıcılara ulaşmanın asıl yolu budur: panel/şoför başlığındaki
// zil sayaç gösterir, açılınca liste + okundu işaretlenir.
model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // yeni-siparis | fiyat-onay | is-atandi | iptal | dogrulama | genel
  title     String
  body      String?
  href      String? // tıklanınca gidilecek panel içi yol
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model CleanerBusiness {
  id          String  @id @default(cuid())
  owner       User    @relation("BusinessOwner", fields: [ownerId], references: [id])
  ownerId     String  @unique
  name        String
  description String?
  address     String
  city        String
  district    String
  lat         Float
  lng         Float
  phone       String
  // Ek iletişim numaraları — müşteri vitrini "Sabit Hat" + "GSM & WhatsApp"
  // gruplu gösterir. phone birincil GSM'dir (SMS bildirimleri oraya gider).
  gsmPhone2     String? // ikinci GSM & WhatsApp numarası
  landlinePhone String? // sabit hat (0 2xx/3xx/4xx...)

  workingHours            Json? // {"mon":{"open":"09:00","close":"19:00"}, ...}
  deliveryEstimateMinDays Int? // örn 2
  deliveryEstimateMaxDays Int? // örn 3

  taxNumber          String? // vergi no (doğrulama için) — VKN(10)/TCKN(11)
  // FATURA BİLGİLERİ: platform işletmeye abonelik faturası keserken (mali müşavir
  // /muhasebe'de görür) mevzuaten gerekli alanlar. Abonelik ödemesinden ÖNCE zorunlu.
  billingTitle       String? // fatura ünvanı (yasal unvan; name yalnız görünen ad)
  taxOffice          String? // vergi dairesi
  billingAddress     String? // fatura adresi (abonelik ödemesi öncesi zorunlu)
  billingCode        String? @unique // cari/abone kodu (HY-0001) — muhasebe eşleştirmesi
  // İşletme logosu (kare, ≤512px WebP) — kartta ve profil başlığında gösterilir.
  logoUrl            String?
  googleProfileUrl   String? // işletmenin Google Haritalar/İşletme profili linki (gerçek Google yorumları)
  contractAcceptedAt DateTime? // platform sözleşmesi onay zamanı
  contractVersion    String? // onaylanan aracılık sözleşmesi sürümü (ETAHS Yön. md.11/2-c)
  verification       VerificationStatus @default(PENDING)
  isVisible          Boolean            @default(false) // profil tam + doğrulanmış olunca true
  // Admin/destek eliyle açıldı: şoför YAYIN şartından muaf (sipariş almak
  // için yine şoför gerekir — sipariş API'si engeller).
  createdByAdmin     Boolean            @default(false)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  adminNote String? // yalnız admin görür: denetim/gerekçe notları

  // Tatil modu: bu tarihe kadar YENİ kamu siparişi kabul edilmez (profil yayında
  // kalır, sipariş butonu kapanır; panelden manuel sipariş etkilenmez).
  pausedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceAreas ServiceArea[]
  photos       BusinessPhoto[]
  pricing      PricingItem[]
  drivers      Driver[]
  orders       Order[]
  reviews      Review[]
  badges       Badge[]
  subscription Subscription?
  payments     SubscriptionPayment[]
  commissions  CommissionEntry[]
  // Komisyoncu referansı: bu işletmeyi platforma hangi komisyoncu getirdi.
  // Her abonelik ödemesinde (yenileme dahil) komisyon tahakkuku üretir.
  referredByAgent   Agent?  @relation(fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredByAgentId String?
  usedReferralCodes AgentReferralCode[] @relation("CodeUsedBy")
  // Abonelik indirimi: discountUntil geçerliyken her ödeme %discountPercent
  // indirimli tahsil edilir (kaynak: premium komisyoncu kodu VEYA admin eli).
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountUntil   DateTime?

  @@index([city, district])
}

model ServiceArea {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  city       String
  district   String

  @@index([city, district])
}

model BusinessPhoto {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  url        String
  isBefore   Boolean         @default(false)
  isAfter    Boolean         @default(false)
  caption    String?
  createdAt  DateTime        @default(now())
}

model PricingItem {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  label      String // "Makine Halısı", "Yün/El Dokuma", "Saçak Onarımı" vb.
  unit       PricingUnit     @default(PER_M2)
  price      Decimal         @db.Decimal(10, 2)
  isAddon    Boolean         @default(false) // ek hizmet mi
  createdAt  DateTime        @default(now())
}

model Driver {
  id         String          @id @default(cuid())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String          @unique
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  isOnShift  Boolean   @default(false) // mesaide mi
  lastLat    Float? // en güncel canlı konum
  lastLng    Float?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  orders          Order[]
  pings           DriverLocationPing[]
  stops           DriverStop[]
  privacyNoticeAt DateTime? // KVKK aydınlatmasının şoföre ilk gösterim anı (Tebliğ md.6)
}

// ham konum akışı — halıcının canlı izlemesi için
model DriverLocationPing {
  id         String   @id @default(cuid())
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId   String
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  @@index([driverId, recordedAt])
}

// durak kaydı — "şu saatte, şu konumda, şu kadar durdu"; aylık raporlanır
model DriverStop {
  id          String    @id @default(cuid())
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId    String
  lat         Float
  lng         Float
  address     String? // ters-geocode (opsiyonel)
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int? // ne kadar durdu
  periodYear  Int // aylık raporlama için
  periodMonth Int
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?

  @@index([driverId, periodYear, periodMonth])
}

model Order {
  id            String  @id @default(cuid())
  trackingToken String  @unique @default(cuid()) // SMS takip linki
  code          String? @unique // kısa, müşteri-dostu takip kodu (ör. HLK-4F2A9)

  customer      User?   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  customerName  String // kayıtsız müşteri de sipariş verebilir
  customerPhone String
  // Opsiyonel: takip linki e-postayla gider (SMS ertelendi — bedava teyit kanalı).
  customerEmail String?
  pickupAddress String
  pickupLat     Float?
  pickupLng     Float?
  approxM2      Float?
  note          String?

  business   CleanerBusiness @relation(fields: [businessId], references: [id])
  businessId String
  driver     Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId   String?

  status           OrderStatus @default(CREATED)
  rejectReason     String?
  // Panelden (dükkâna gelen müşteri için) açılan manuel kayıt — SLA bekçisi,
  // 24s kurtarma ve "yanıt vermedi" bandı bu siparişleri ATLAR.
  isManual         Boolean     @default(false)
  // SLA bekçisi: CREATED'da bekleyen sipariş için işletmeye hatırlatma atıldıysa
  // (sipariş başına bir kez; saatlik tik src/lib/orderSla.ts)
  staleRemindedAt  DateTime?
  // 24 saat kademesi: üye müşteriye e-posta + adminlere zil atıldıysa (bir kez)
  staleEscalatedAt DateTime?

  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  priceTotal    Decimal?      @db.Decimal(10, 2)
  commission    Decimal?      @db.Decimal(10, 2) // kartla ödemede %3

  pickupPhotoUrl   String?
  deliveryPhotoUrl String? // şoförün teslimde çektiği kanıt fotoğrafı

  // Mesafeli Sözleşmeler Yönetmeliği md.7: ön bilgilendirme TEYİDİ — onay kutusu
  // işaretlendiği an + o an geçerli sözleşme sürümü (ispat yükü platformda).
  consentAt       DateTime?
  contractVersion String?

  // md.15/1-h: kesin fiyat bildirimi + müşterinin ifaya başlama ONAYI (ispatlı).
  quotedPrice     Decimal?  @db.Decimal(10, 2) // işletmenin ölçüm sonrası bildirdiği kesin fiyat
  priceApprovedAt DateTime? // müşterinin takip sayfasından onay anı
  estimatedDays   Int? // halıcının verdiği tahmini teslim süresi (gün)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OrderEvent[]
  photos OrderPhoto[]
  review Review?
  stops  DriverStop[]

  @@index([businessId, status])
}

// Kayıt öncesi e-posta doğrulama kodu (hesap henüz yokken; 10 dk geçerli).
model SignupOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  attempts  Int      @default(0) // yanlış deneme sayısı (5'te kilit)
  createdAt DateTime @default(now())
}

// SMS gönderim kaydı — bilgilendirme/teyitlerin ispatı (Mesafeli Yön. md.20).
model SmsLog {
  id        String   @id @default(cuid())
  to        String
  body      String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

// Halıcının siparişe eklediği fotoğraflar (önce/sonra, süreç) — müşteri takipte görür.
model OrderPhoto {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  url       String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Review {
  id         String          @id @default(cuid())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String          @unique // yorum sadece tamamlanmış siparişten (sipariş başına 1)
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  // Misafir müşteri (hesapsız, takip koduyla) yorum bırakabilir → opsiyonel.
  // Görünen ad siparişteki customerName'den gelir (maskelenerek).
  customer   User?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String?
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([businessId])
}

model Subscription {
  id                 String             @id @default(cuid())
  business           CleanerBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId         String             @unique
  status             SubscriptionStatus @default(TRIAL)
  priceMonthly       Decimal            @default(2000) @db.Decimal(10, 2)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // iyzico tekrarlayan abonelik (düzenli ödeme talimatı) — her ay otomatik çekim.
  iyzicoSubRef      String?   @unique // iyzico subscriptionReferenceCode
  iyzicoCustomerRef String? // iyzico customerReferenceCode (kart saklı)
  autoRenew         Boolean   @default(false) // aktif düzenli ödeme talimatı var mı
  canceledAt        DateTime? // talimat iptal anı (dönem sonuna kadar açık kalır)

  // ELLE ÖDEYENLER İÇİN YENİLEME BEKÇİSİ (2026-07-25): banka kartlı işletmeler
  // talimat veremiyor (iyzico abonelik NON3D → debit reddi), her ay elle ödüyor.
  // Sessizce yayından düşmesinler diye 3 gün önce hatırlatma, dolduğunda bildirim
  // gider. Alanlar HANGİ dönem için gönderildiğini tutar → dönem başına tek mail.
  renewalRemindedFor DateTime?
  expiredNotifiedFor DateTime?
}

// Abonelik ödemesi kaydı — iyzico Checkout. Idempotency (çift callback/replay)
// ve yasal saklama (6563 md.11/3 on yıl) için her ödeme burada tutulur.
model SubscriptionPayment {
  id              String          @id @default(cuid())
  business        CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String
  // iyzico'ya conversationId olarak bu kaydın id'si gider; callback bununla bulur.
  status          String          @default("PENDING") // PENDING | PAID | FAILED
  amount          Decimal         @db.Decimal(10, 2) // KDV dahil tahsil edilen (2400)
  iyzicoToken     String? // checkout token
  iyzicoPaymentId String?         @unique // iyzico ödeme kimliği — idempotency anahtarı
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime        @default(now())
  paidAt          DateTime?

  @@index([businessId])
  commission CommissionEntry?
}

// ---- KOMİSYONCU (satış ortağı) sistemi ----
// Admin hesap açarken yüzdeyi belirler; komisyoncunun koduyla gelen her
// işletmenin HER abonelik ödemesinde (ilk + yenileme) KDV HARİÇ net tutar
// üzerinden komisyon tahakkuk eder — abonelik sürdükçe devam eder.
model Agent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  percent   Decimal  @db.Decimal(5, 2) // NET (KDV hariç) tutar üzerinden yüzde
  active    Boolean  @default(true) // pasif komisyoncuya YENİ tahakkuk işlemez
  // PREMIUM yetkisi (2026-07-23): kod üretirken abonelik fiyatına istediği
  // yüzdede + istediği sürede indirim tanımlayabilir. Admin verir/alır.
  canDiscount Boolean @default(false)
  createdAt DateTime @default(now())

  referrals CleanerBusiness[]
  entries   CommissionEntry[]
  codes     AgentReferralCode[]
}

// TEK KULLANIMLIK referans kodu (2026-07-23 kullanıcı kararı: kalıcı kod YOK):
// komisyoncu her müşteri için panelinden yeni kod üretir; kod bir işletmeye
// bağlanınca YANAR (usedAt dolar), tekrar kullanılamaz.
model AgentReferralCode {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  code      String    @unique // HYK-XXXXXX
  // Koda gömülü abonelik indirimi (yalnız canDiscount komisyoncu tanımlar):
  // kodla kaydolan işletmenin fiyatı discountMonths boyunca %discountPercent düşer.
  discountPercent Decimal? @db.Decimal(5, 2)
  discountMonths  Int?
  createdAt DateTime  @default(now())
  usedAt    DateTime? // dolunca kod tükenmiştir
  usedByBusiness   CleanerBusiness? @relation("CodeUsedBy", fields: [usedByBusinessId], references: [id], onDelete: SetNull)
  usedByBusinessId String?

  @@index([agentId, createdAt])
}

model CommissionEntry {
  id         String              @id @default(cuid())
  // Restrict (inceleme bulgusu): komisyon DEFTERİ silinme zincirleriyle yok
  // olmasın — ödenmemiş borç kaydı, bağlı kayıt silinse bile korunur.
  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentId    String
  business   CleanerBusiness     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId String
  payment    SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId  String              @unique // idempotency: her ödemeye EN FAZLA 1 komisyon
  grossAmount Decimal @db.Decimal(10, 2) // tahsil edilen (KDV dahil)
  netAmount   Decimal @db.Decimal(10, 2) // KDV hariç matrah
  percent     Decimal @db.Decimal(5, 2) // tahakkuk anındaki yüzde (sonradan değişse de sabit)
  amount      Decimal @db.Decimal(10, 2) // komisyoncuya ödenecek tutar
  paidAt      DateTime? // admin "ödendi" işaretleyince dolar
  createdAt   DateTime  @default(now())

  @@index([agentId, createdAt])
}

model Badge {
  id         String          @id @default(cuid())
  business   CleanerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  type       BadgeType
  grantedAt  DateTime        @default(now())

  @@unique([businessId, type])
}

// Boş şehir/ilçe sayfasındaki "açılınca haber ver" e-posta kaydı. İki amaç:
// (1) şehir açılınca hazır müşteri listesi, (2) hangi şehirde talep biriktiği
// verisi (işletme kazanım görüşmelerinde kullanılır; /admin'de sayılır).
model CityLead {
  id         String    @id @default(cuid())
  city       String // kanonik il adı (src/lib/cities.ts)
  district   String? // ilçe sayfasından geldiyse kanonik ilçe adı
  email      String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // "bölgende açıldık" maili atıldıysa (kişi başı bir kez)

  @@unique([city, email]) // aynı il için aynı e-posta bir kez (upsert)
  @@index([city])
}

// Genel amaçlı anahtar-değer durumu (tekil zamanlayıcı işaretleri vb. —
// örn. weeklyDigestSentAt: haftalık özet maili en son ne zaman gitti).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
