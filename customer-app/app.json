{
  "expo": {
    "name": "En Yakın Halı Yıkama",
    "slug": "hali-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hali",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d9488"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki halı yıkamacıları gösterebilmek için konumun kullanılır; konumun kaydedilmez, kimseyle paylaşılmaz."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.enyakinhaliyikamaservisi.customer",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki halı yıkamacıları gösterebilmek için konumun kullanılır; konumun kaydedilmez, kimseyle paylaşılmaz."
      }
    },
    "android": {
      "package": "com.enyakinhaliyikamaservisi.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9488"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "ANDROID_GOOGLE_MAPS_ANAHTARI_BURAYA"
        }
      }
    },
    "owner": "enyakinhaliyikamaservisi"
  }
}
